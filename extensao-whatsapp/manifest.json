{
  "manifest_version": 3,
  "name": "Amor In Gestão — Conversas do WhatsApp",
  "version": "1.2.2",
  "description": "Painel lateral dentro do CRM Amor In Gestão que conecta o WhatsApp Web e arquiva as conversas das comissões e alunos por turma.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://mpodlzptnhvskqmbcsdv.supabase.co/*",
    "https://www.grupoamorin.com.br/*",
    "https://grupoamorin.com.br/*",
    "https://analytics-negocio-amor-in.pages.dev/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Amor In Gestão — Conversas"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.grupoamorin.com.br/*",
        "https://grupoamorin.com.br/*",
        "https://analytics-negocio-amor-in.pages.dev/*",
        "http://localhost/*"
      ],
      "js": ["config.js", "crm-panel.js"],
      "css": ["crm-panel.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/wppconnect-wa.js", "wa-inject.js"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
